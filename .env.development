# Yalnız inkişaf serveri üçün (npm run dev). Build zamanı oxunmur —
# istehsal dəyərləri .env faylında qalır.

# 0.0.0.0 — bütün şəbəkə interfeyslərini dinlə.
# «localhost» olanda server yalnız bu kompüterə cavab verirdi, ona görə
# telefondan 172.31.x.x:3000 ünvanı açılmırdı.
VITE_HOST=0.0.0.0
VITE_PORT=3000

# Nisbi ünvan: sorğu səhifənin açıldığı host üzərindən gedir və Vite onu
# backend-ə ötürür (vite.config.js -> server.proxy).
# Tam ünvan yazsaydıq, telefonda «localhost» telefonun özünü göstərərdi.
VITE_API_URL=/api

# Backend başqa portda işləyirsə burada dəyişin
VITE_API_TARGET=https://localhost:7277
